# Copy to .env (docker compose reads it automatically)
MQTT_HOST=192.168.1.91
MQTT_PORT=1883
# Leave empty for an anonymous broker
MQTT_USERNAME=
MQTT_PASSWORD=

# Home Assistant MQTT discovery (off by default)
HA_DISCOVERY_ENABLED=false
HA_DISCOVERY_PREFIX=homeassistant
# Units to announce, comma separated, optional "=Name" per unit
DAIKIN_HOSTS=192.168.1.150=Living room
# Seconds between two state polls (0 = no polling)
DAIKIN_POLL_INTERVAL=60
